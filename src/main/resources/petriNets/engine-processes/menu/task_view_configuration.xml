    <data type="i18n">
        <id>task_empty_content_text</id>
        <title name="task_empty_content_text">Empty content text</title>
        <desc name="task_empty_content_text_desc">If empty, default text will be used</desc>
    </data>
    <data type="text">
        <id>task_empty_content_icon</id>
        <title name="task_empty_content_icon">Empty content icon</title>
        <desc name="task_empty_content_icon_desc">If empty, default icon will be used</desc>
        <event type="set">
            <id>0</id>
            <actions phase="post">
                <action>
                    icon: f.this,
                    iconPreview: f.task_empty_content_icon_preview;

                    if (icon.value == "") {
                        change iconPreview value {<![CDATA["""<span></span>"""]]>}
                        return
                    }

                    change iconPreview value {
                        <![CDATA["""<link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet"><span class="material-icons">"""]]> + icon.value + <![CDATA["""</span>"""]]>
                    }
                </action>
            </actions>
        </event>
    </data>
    <data type="text">
        <id>task_empty_content_icon_preview</id>
        <title name="task_empty_content_icon_preview">Empty content icon preview</title>
        <component>
            <name>htmltextarea</name>
        </component>
    </data>
    <data type="stringCollection">
