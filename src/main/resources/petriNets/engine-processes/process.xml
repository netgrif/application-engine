		<event type="finish">
			<id>deploy_finish</id>
			<title name="deploy_finish">Deploy</title>
			<actions phase="pre">
				<action id="action1">
					<![CDATA[
					state: f.state,
					title: f.title,
					version: f.version,
					mongo_id: f.mongo_id,
					xml_text: f.xml_text,
					xml_file: f.xml_file,
					form: t.form;

					// TODO: move xml text to file field
					def net = importPetriNet(xml_text.value as String)
					change state value { "deployed" }
					change mongo_id value { net.stringId }
					make mongo_id,visible on form when { true }
					make xml_file,visible on form when { true }
					changeCaseProperty "title" about { "${title.value} ${version.value}" as String }

					def editIsAssigned = useCase.tasks.any {it.transition == "edit"}
					if (editIsAssigned) {
						cancelTask("edit")
					}
					]]>
				</action>
			</actions>
		</event>
