		<init>New Process</init>
		<event type="set">
			<id>title_set</id>
			<actions phase="post">
				<action id="action9">
					<![CDATA[
					version: f.version,
					title: f.title;
					changeCaseProperty "title" about { "${title.value} ${version.value}" as String }
