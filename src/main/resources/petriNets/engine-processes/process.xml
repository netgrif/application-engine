	<function scope="process" name="deleteWithCases">
		<![CDATA[
		{ mongo_id, log_delete ->
		    try {
		        petriNetService.deletePetriNet(mongo_id.value, loggedUser().transformToLoggedUser())
				change log_delete value { "Petri net deleted successfully" }
		    } catch (Exception e) {
		        String message = "Error deleting Petri net with ObjectId(${mongo_id.value}): ${e.message}" as String
		        log.error(message, e)
		        change log_delete value { message }
		    }
		}
		]]>
	</function>
