		</event>
	</data>
	<data type="text" immediate="true">
		<id>version</id>
		<title name="version">Version</title>
		<validations>
			<validation>
				<expression>regex ^(0|[1-9]\d*)\.(0|[1-9]\d*)\.(0|[1-9]\d*)$</expression>
			</validation>
		</validations>
		<init>1.0.0</init>
		<event type="set">
			<id>version_set</id>
			<actions phase="post">
				<action id="version_set">
					<![CDATA[
					version: f.version,
					title: f.title;
					changeCaseProperty "title" about { "${title.value} ${version.value}" as String }
					]]>
				</action>
			</actions>
		</event>
	</data>
	<data type="enumeration_map">
		<id>version_increment</id>
		<title name="version_increment">Version increment</title>
		<options>
			<option key="MAJOR">Major</option>
			<option key="MINOR">Minor</option>
			<option key="PATCH">Patch</option>
		</options>
		<event type="set">
			<id>version_increment_set</id>
			<actions phase="post">
				<action id="action7">
					<![CDATA[
					version_increment: f.version_increment,
					copy_version: f.copy_version,
					version: f.version;
				 	try {
                        def newVersion = Version.from(version.value)
                        newVersion.increment(version_increment.value as VersionType)
                        change copy_version value { newVersion as String }
                    } catch (Exception e) {
                        log.error("Failed to calculate new version", e)
                    }
					]]>
				</action>
			</actions>
		</event>
	</data>
