			<option key="PATCH">Patch</option>
		</options>
		<event type="set">
			<id>version_increment_set</id>
			<actions phase="post">
				<action id="action7">
					<![CDATA[
					version_increment: f.version_increment,
					copy_version: f.copy_version,
					version: f.version;
				 	try {
                        def newVersion = Version.from(version.value)
                        newVersion.increment(version_increment.value as VersionType)
                        change copy_version value { newVersion as String }
                    } catch (Exception e) {
                        log.error("Failed to calculate new version", e)
                    }
					]]>
				</action>
			</actions>
		</event>
