					xml_text: f.xml_text,
					icon: f.icon,
					copy_version: f.copy_version,
					version: f.version,
					id: f.id,
					title: f.title;

					def updatedXml = xml_text.value.replace("<version>${version.value}</version>", "<version>${copy_version.value}</version>") as String
					def newProcess = createCase("process", title.value)
					def editTask = assignTask("edit", newProcess)
					setData(editTask, [
							"id": [
							        "type": "text",
									"value": id.value
							],
							"version": [
							        "type": "text",
									"value": copy_version.value
							],
							"title": [
							        "type": "text",
									"value": title.value
							],
							"icon": [
							        "type": "text",
									"value": icon.value
							],
							"xml_text": [
							        "type":"text",
									"value": updatedXml
							]
					])
					finishTask(editTask)
					]]>
				</action>
			</actions>
		</event>
