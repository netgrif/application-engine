				<action id="action_0">
					<![CDATA[
					mongo_id: f.mongo_id,
					log_delete: f.log_delete;
					try {
				   		petriNetService.deletePetriNet(mongo_id.value, loggedUser())
				   	} catch (Exception e) {
						String message = "Error deleting Petri net with ObjectId(${mongo_id.value}): ${e.message}" as String
						log.error(message, e)
						change log_delete value { message }
				   	}
