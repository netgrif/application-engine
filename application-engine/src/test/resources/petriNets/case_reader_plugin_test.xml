    <!-- TEST 1: showCaseTitle(Case) -->
    <data type="button">
        <id>btn_test_1</id>
        <title></title>
        <placeholder>TOTOK.caseReader.showCaseTitle(useCase)</placeholder>
        <component>
            <name>flat</name>
        </component>
        <event type="set">
            <id>e_btn_test_1</id>
            <actions phase="post">
                <action>
                    res_test_1: f.res_test_1;
                    try {
                    TOTOK.caseReader.showCaseTitle(useCase)
                    change res_test_1 value { "SUCCESS: showCaseTitle executed for case [title: " + useCase.title + "]" }
                    } catch (Exception e) {
                    change res_test_1 value { "ERROR: " + e.message }
                    }
                </action>
            </actions>
        </event>
    </data>
    <data type="text">
        <id>res_test_1</id>
        <title>Result for showCaseTitle(Case)</title>
    </data>

